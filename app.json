{
  "expo": {
    "name": "KrishiBazar (कृषि बाज़ार)",
    "slug": "krishibazar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#16A34A",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#16A34A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krishibazar.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16A34A"
      },
      "package": "com.krishibazar.app"
    },
    "web": {
      "favicon": "./favicon.png",
      "bundler": "metro"
    }
  }
}
